---
import MainLayout from '@/layouts/MainLayout.astro';
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import { SITE } from '@data/constants';

export async function getStaticPaths() {
  const services = [
    {
      id: 'strategy-realisation',
      title: 'Translating Vision into Realisation',
      description:
        'Our experienced specialists bring precision and quality to every project. From small optimizations to major strategic trajectories, Decernia offers reliable services to turn plans into concrete results.',
      content:
        'Here you will find the complete, in-depth text on how Decernia turns strategy into tangible results within complex networks and systems...',
      subjectParam: 'strategy-governance',
    },
    {
      id: 'custom-strategies',
      title: 'Custom Strategies for Complex Challenges',
      description:
        'For larger organizations, Decernia offers specific custom solutions to tackle complex organizational issues. By understanding your unique needs, we design strategies that increase efficiency and accelerate growth.',
      content:
        'Here you will find the complete, in-depth text regarding custom strategies for complex organizational challenges and tailored advisory models...',
      subjectParam: 'custom-strategies',
    },
  ];

  return services.map(service => ({
    params: { id: service.id },
    props: { service },
  }));
}

const { service } = Astro.props;

const pageTitle = `${service.title} | ${SITE.title}`;
const metaDescription = service.description;
---

<MainLayout title={pageTitle} customDescription={metaDescription}>
  <section class="mx-auto max-w-4xl px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="space-y-6">
      <h1
        class="text-3xl font-bold tracking-tight text-neutral-800 md:text-4xl dark:text-neutral-200"
      >
        {service.title}
      </h1>
      <p class="text-xl text-neutral-600 dark:text-neutral-400">
        {service.description}
      </p>

      <div class="prose prose-lg dark:prose-invert mt-8">
        <p>{service.content}</p>
      </div>

      <div class="mt-12 rounded-xl bg-neutral-100 p-8 dark:bg-neutral-800">
        <h3
          class="mb-2 text-xl font-bold text-neutral-800 dark:text-neutral-200"
        >
          Interested in this service?
        </h3>
        <p class="mb-6 text-neutral-600 dark:text-neutral-400">
          Feel free to reach out to us to discuss the possibilities for your
          organization.
        </p>
        <a href={`/en/contact?subject=${service.subjectParam}`}>
          <AuthBtn title="Get in touch" />
        </a>
      </div>
    </div>
  </section>
</MainLayout>
