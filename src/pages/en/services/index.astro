---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE } from '@data/constants';

// Import necessary images
import blueprints from '@images/blueprints-image.avif';
import personWorking from '@images/person-working.avif';
import beforeAfter from '@images/before-after.avif';
import constructionWorkers from '@images/construction-workers.avif';
import aerialView from '@images/aerial-view.avif';
import usingTools from '@images/using-tools.avif';
import progressBuilding from '@images/progress-building.avif';
import underConstruction from '@images/under-construction.avif';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Expert Advice and Consultancy',
    subTitle:
      'Embarking on a new trajectory or transformation process can be overwhelming. With our professional consultancy services, we guide you every step of the way to ensure well-informed decisions. Our experts provide tailored advice on strategy, architecture, and execution.',
    single: false,
    imgOne: blueprints,
    imgOneAlt: 'Strategic blueprints and digital workspace',
    imgTwo: personWorking,
    imgTwoAlt: 'Consultant working at the office',
  },
  {
    isRightSection: false,
    title: 'Translating Vision into Realization',
    subTitle:
      'Our experienced specialists bring precision and quality to every project. From small optimizations to major strategic trajectories, Decernia offers reliable services to turn plans into concrete results.',
    img: beforeAfter,
    imgAlt: 'Transformation and progress of a project',
    btnExists: true,
    btnTitle: 'Read more',
    btnURL: '/en/services/strategy-realisation',
  },
  {
    isRightSection: true,
    title: 'Guiding Projects with Professional Direction',
    subTitle:
      'Effective project management is the foundation of any successful initiative. Decernia offers rigorous planning and tight governance to keep your project on time and within budget. We manage the complexity of execution so you can focus on the vision.',
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: 'Team discussing project progress',
    imgTwo: aerialView,
    imgTwoAlt: 'Overview of a structured project',
  },
  {
    isRightSection: false,
    title: 'Ensuring Sustainable Results',
    subTitle:
      "Our commitment doesn't stop at delivery. Decernia provides continuous support to guarantee the long-term quality and effectiveness of the chosen solutions.",
    img: usingTools,
    imgAlt: 'Specialist working with professional equipment',
  },
  {
    isRightSection: true,
    title: 'Custom Strategies for Complex Challenges',
    subTitle:
      'For larger organizations, Decernia offers specific custom solutions to tackle complex organizational issues. By understanding your unique needs, we design strategies that increase efficiency and accelerate growth.',
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: 'Organization development and progress',
    imgTwo: underConstruction,
    imgTwoAlt: 'Sustainable development in execution',
    btnExists: true,
    btnTitle: 'Learn more',
    btnURL: '/en/services/custom-strategies',
  },
];
---

<MainLayout
  title={`Services | ${SITE.title}`}
  lang="en"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://decernia.nl/en/services',
    url: 'https://decernia.nl/en/services',
    name: `Expert Consultancy Services | Decernia`,
    description:
      'Decernia combines expertise with your vision for result-oriented advisory and consultancy services.',
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://decernia.nl/',
      name: 'Decernia',
      description:
        'Decernia offers expert advice and strategic solutions to elevate your organization and projects.',
    },
    inLanguage: 'en',
  }}
>
  <MainSection
    title="Connecting Expertise to Your Vision"
    subTitle="At Decernia, we offer complete solutions and high-quality consultancy services. Our experienced team is dedicated to supporting your project from idea to realization."
    btnExists={true}
    btnTitle="Schedule a no-obligation consultation"
    btnURL={getRelativeLocaleUrl('en', 'contact') + '?subject=consultation'}
  />

  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <FeaturesStats
    title="In Numbers"
    subTitle="Our focus on quality and reliability is visible in every trajectory. We are committed to sustainable results that stand the test of time."
    mainStatTitle="96%"
    mainStatSubTitle="of our clients rate their partnership with Decernia as excellent"
    stats={[
      {
        stat: '99.8%',
        description: 'successful project delivery',
      },
      {
        stat: '500+',
        description: 'completed trajectories',
      },
      {
        stat: '85%',
        description: 'recurring clients',
      },
    ]}
  />
</MainLayout>
