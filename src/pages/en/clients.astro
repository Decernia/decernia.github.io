---
// Importing necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import { SITE } from '@data/constants';

// Testimonial data (English)
const testimonials = [
  {
    content:
      "Adopting Decernia's architecture frameworks transformed our enterprise steering overnight. The clarity in modeling business capabilities and alignment across IT systems is unmatched. Truly essential for complex organizational change.",
    author: 'Jason Clark',
    role: 'Lead Enterprise Architect | TechScale',
    avatarSrc:
      'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?q=80&w=1374&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
    avatarAlt: 'Portrait of Jason Clark',
  },
  {
    content:
      'As a digital transformation lead, I rely on clean, deterministic modeling tools. Decernia provided the exact framework needed to map our target state with total precision. Highly recommended for any large-scale transformation.',
    author: 'Maria Gonzalez',
    role: 'Head of Digital Strategy | Innovate Corp',
    avatarSrc:
      'https://images.unsplash.com/photo-1544005313-94ddf0286df2?q=80&w=1376&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
    avatarAlt: 'Portrait of Maria Gonzalez',
  },
  {
    content:
      "Having worked in business architecture for over 15 years, Decernia's approach to governance and capability mapping stands out as best-in-class. It streamlines decision-making across all stakeholder levels.",
    author: 'Richard Kim',
    role: 'Principal Business Architect | Enterprise Solutions',
    avatarSrc:
      'https://images.unsplash.com/photo-1474176857210-7287d38d27c6?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
    avatarAlt: 'Portrait of Richard Kim',
  },
];

const pageTitle = `Client Stories & Reviews | ${SITE.title}`;
const metaDescription =
  'Read how enterprise architects and digital leaders experience their collaboration with Decernia and the deployment of our architecture frameworks.';
---

<MainLayout
  title={pageTitle}
  lang="en"
  customDescription={metaDescription}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://decernia.nl/en/clients',
    url: 'https://decernia.nl/en/clients',
    name: 'Client Stories & Reviews | Decernia',
    description: metaDescription,
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://decernia.nl/en',
      name: 'Decernia',
    },
    inLanguage: 'en',
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex flex-col gap-2">
        <h1
          class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
        >
          What Our Clients Say
        </h1>
        <p
          class="max-w-(--breakpoint-sm) text-pretty text-neutral-600 dark:text-neutral-400"
        >
          Discover how our architecture tools and framework solutions empower
          enterprise success.
        </p>
      </div>
    </div>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        testimonials.map(item => (
          <div class="flex flex-col overflow-hidden rounded-xl bg-neutral-100 dark:bg-neutral-800">
            <div class="flex-auto p-6 sm:p-8">
              <p class="text-neutral-600 dark:text-neutral-300">
                {item.content}
              </p>
            </div>
            <div class="mt-auto flex items-center gap-4 bg-neutral-200/60 p-6 sm:px-8 sm:py-5 dark:bg-neutral-900/60">
              <img
                class="h-12 w-12 rounded-full object-cover"
                src={item.avatarSrc}
                alt={item.avatarAlt}
              />
              <div>
                <h3 class="font-semibold text-neutral-800 dark:text-neutral-200">
                  {item.author}
                </h3>
                <p class="text-sm text-neutral-500 dark:text-neutral-400">
                  {item.role}
                </p>
              </div>
            </div>
          </div>
        ))
      }
    </section>
  </div>
</MainLayout>
