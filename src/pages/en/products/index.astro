---
// Importing necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import PrimaryCTA from '@components/ui/buttons/PrimaryCTA.astro';
import CardSmall from '@components/ui/cards/CardSmall.astro';
import CardWide from '@components/ui/cards/CardWide.astro';
import FeaturesStatsAlt from '@components/sections/features/FeaturesStatsAlt.astro';

// Importing necessary functions from Astro
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

// Importing constants
import { SITE } from '@data/constants';

// Fetching all the product related content in English and sorting it by main.id
const product: CollectionEntry<'products'>[] = (
  await getCollection('products', ({ id }) => {
    return id.startsWith('en/');
  })
).sort(
  (a: CollectionEntry<'products'>, b: CollectionEntry<'products'>) =>
    a.data.main.id - b.data.main.id
);

// Define variables for page content
const title: string = 'Products & Solutions';
const subTitle: string =
  'Explore the clarity and strategic power of Decernia architecture tools and frameworks. Engineered for business architects and decision-makers navigating complex enterprise ecosystems.';

const pageTitle = `Products | ${SITE.title}`;
const metaDescription =
  'Explore Decernia architectural tools and framework solutions designed for enterprise decision-makers and business architects.';
const ogTitle = 'Products & Architectural Solutions | Decernia';
---

<MainLayout
  title={pageTitle}
  lang="en"
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://decernia.nl/en/products',
    url: 'https://decernia.nl/en/products',
    name: 'Products & Solutions | Decernia',
    description:
      'Explore Decernia architectural tools and framework solutions designed for enterprise decision-makers and business architects.',
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://decernia.nl/en',
      name: 'Decernia',
      description:
        'Decernia offers strategic business architecture and IT consultancy solutions to guide complex enterprise transformations.',
    },
    inLanguage: 'en',
  }}
>
  <div
    class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 2xl:max-w-full"
  >
    <div class="mb-4 flex items-center justify-between gap-8 sm:mb-8 md:mb-12">
      <div class="flex items-center gap-12">
        <h1
          class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
        >
          {title}
        </h1>
        {
          subTitle && (
            <p class="hidden max-w-(--breakpoint-sm) text-pretty text-neutral-600 md:block dark:text-neutral-400">
              {subTitle}
            </p>
          )
        }
      </div>
      <PrimaryCTA title="Client Stories" url="/en/clients" noArrow={true} />
    </div>

    <section class="grid grid-cols-1 gap-4 sm:grid-cols-3 md:gap-6 xl:gap-8">
      {
        product.map((product, index) => {
          const position = index % 4;
          if (position === 0 || position === 3) {
            return <CardSmall product={product} productLocale="en" />;
          } else {
            return <CardWide product={product} productLocale="en" />;
          }
        })
      }
    </section>
  </div>

  {/* Features statistics section */}
  <FeaturesStatsAlt
    title="Why Choose Decernia?"
    subTitle="Transform complex organizational strategy into actionable architecture. Whether mapping domain boundaries or establishing governance frameworks, Decernia gives you the control and clarity to build with confidence."
    benefits={[
      'Robust and deterministic frameworks for scalable architecture.',
      'Innovative solutions tailored to modern IT & business alignment.',
      'Dedicated consultancy support to ensure project success.',
    ]}
  />
</MainLayout>
