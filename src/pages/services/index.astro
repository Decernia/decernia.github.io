---
// Import necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import MainSection from '@components/ui/blocks/MainSection.astro';
import LeftSection from '@components/ui/blocks/LeftSection.astro';
import RightSection from '@components/ui/blocks/RightSection.astro';
import FeaturesStats from '@components/sections/features/FeaturesStats.astro';
import { getRelativeLocaleUrl } from 'astro:i18n';
import { SITE } from '@data/constants';

// Import necessary images
import blueprints from '@images/blueprints-image.avif';
import personWorking from '@images/person-working.avif';
import beforeAfter from '@images/before-after.avif';
import constructionWorkers from '@images/construction-workers.avif';
import aerialView from '@images/aerial-view.avif';
import usingTools from '@images/using-tools.avif';
import progressBuilding from '@images/progress-building.avif';
import underConstruction from '@images/under-construction.avif';

interface Article {
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
}

const articles: Article[] = [
  {
    isRightSection: true,
    title: 'Deskundige Begeleiding & Advies',
    subTitle:
      'Het starten van een complexe veranderopgave kan overweldigend zijn. Met onze strategische adviesdiensten begeleiden we u door elke fase, zodat u onderbouwde en gewogen besluiten neemt. Of u nu een interne projectgroep aanstuurt of een organisatiebrede transformatie leidt: onze experts bieden advies op maat over kaders, projectscope en governance.',
    single: false,
    imgOne: blueprints,
    imgOneAlt:
      'Architectuurmodellen en digitaal dashboard met transformatieplannen.',
    imgTwo: personWorking,
    imgTwoAlt: 'Adviseur in overleg op kantoor',
  },
  {
    isRightSection: false,
    title: 'Strategie omzetten naar Realisatie',
    subTitle:
      'Onze ervaren adviseurs brengen precisie en sturing in elke fase van de uitvoering. Van gerichte interventies tot omvangrijke structuurveranderingen: Decernia biedt daadkrachtige begeleiding om uw visie om te zetten in tastbare resultaten. Wij borgen de hoogste kwaliteit en beheerderbaarheid door gebruik te maken van ons beproefde instrumentarium.',
    img: beforeAfter,
    imgAlt: 'Organisatielandschap voor en na de transformatie',
    btnExists: true,
    btnTitle: 'Lees meer',
    btnURL: '#',
  },
  {
    isRightSection: true,
    title: 'Strakke regie & Bestuurlijke grip',
    subTitle:
      'Doordachte regie vormt de kern van elke geslaagde transformatie. Decernia zorgt voor heldere planningen en robuust programmamanagement die uw initiatieven binnen tijd en budget houden. Wij ontzorgen u bij de complexiteit van ketenafstemming, capaciteitsallocatie en stakeholder management, zodat u focus houdt op uw strategische doelen.',
    single: false,
    imgOne: constructionWorkers,
    imgOneAlt: 'Programmateam stemt de strategische koers af',
    imgTwo: aerialView,
    imgTwoAlt: 'Overzicht van het regie- en architectuurdomein',
  },
  {
    isRightSection: false,
    title: 'Borgen van duurzame wending & Continuïteit',
    subTitle:
      'Onze betrokkenheid stopt niet bij de oplevering. Decernia biedt borging en periodieke toetsing om de lange termijn effectiviteit van uw architectuur en organisatie-inrichting te garanderen. Van reguliere kwaliteitsaudits tot snelle bijsturing bij veranderende wet- en regelgeving: ons team staat voor u klaar.',
    img: usingTools,
    imgAlt: 'Senior adviseur analyseert de governancekaders en architectuur',
  },
  {
    isRightSection: true,
    title: 'Maatwerkstrategieën voor complexe opgaven',
    subTitle:
      'Voor grote organisatiecontexten biedt Decernia op maat gesneden adviesmodellen om specifieke sectoruitdagingen aan te pakken. Door uw unieke dynamiek en kaders grondig te analyseren, ontwerpen we doelgerichte strategieën die uw operationele slagkracht vergroten, de efficiëntie verhogen en uw organisatie wendbaar maken.',
    single: false,
    imgOne: progressBuilding,
    imgOneAlt: 'Inrichting van het nieuwe organisatielandschap in opbouw',
    imgTwo: underConstruction,
    imgTwoAlt: 'Systeem- en procesinrichting in de transformatiefase',
    btnExists: true,
    btnTitle: 'Lees meer',
    btnURL: '#',
  },
];

const pageTitle: string = `Diensten | ${SITE.title}`;
const metaDescription =
  'Door deskundigheid te verbinden met uw visie, biedt Decernia uitzonderlijke begeleiding en integrale oplossingen op het gebied van organisatieinrichting en architectuur, van strategische advisering tot succesvolle realisatie.';
const ogTitle = 'Expert Adviesdiensten | Decernia';
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': 'https://decernia.nl/diensten',
    url: 'https://decernia.nl/diensten',
    name: 'Expert Adviesdiensten | Decernia',
    description:
      'Door deskundigheid te verbinden met uw visie, biedt Decernia uitzonderlijke begeleiding en integrale oplossingen op het gebied van organisatieinrichting en architectuur, van strategische advisering tot succesvolle realisatie.',
    isPartOf: {
      '@type': 'WebSite',
      url: 'https://decernia.nl',
      name: 'Decernia',
      description:
        'Decernia biedt hoogwaardige architectuurkaders en deskundige regie voor het succesvol realiseren van al uw veranderopgaven.',
    },
    inLanguage: 'nl-NL',
  }}
>
  <MainSection
    title="Verbinden van expertise met uw Visie"
    subTitle="Bij Decernia zijn we er trots op dat we integrale oplossingen en hoogwaardige begeleiding bieden op het gebied van organisatie-inrichting en architectuur. Ons ervaren team staat klaar om uw veranderopgave van idee tot succesvolle realisatie te ondersteunen met een breed scala aan gespecialiseerde adviesdiensten."
    btnExists={true}
    btnTitle="Plan een vrijblijvend gesprek"
    btnURL={getRelativeLocaleUrl('nl', 'contact') + '?subject=consultation'}
  />

  {
    articles.map(article => {
      return article.isRightSection ? (
        <RightSection
          title={article.title}
          subTitle={article.subTitle}
          single={article.single}
          imgOne={article.imgOne}
          imgOneAlt={article.imgOneAlt}
          imgTwo={article.imgTwo}
          imgTwoAlt={article.imgTwoAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      ) : (
        <LeftSection
          title={article.title}
          subTitle={article.subTitle}
          img={article.img}
          imgAlt={article.imgAlt}
          btnExists={article.btnExists}
          btnTitle={article.btnTitle}
          btnURL={article.btnURL}
        />
      );
    })
  }

  <FeaturesStats
    title="In cijfers"
    subTitle="Onze toewijding aan kwaliteit en robuustheid is zichtbaar in elke opgave die wij aanvaarden. Bij Decernia zetten we ons in voor het leveren van toonaangevende advies- en regiediensten die borgen dat uw organisatie-inrichting en architectuur duurzaam bestendig zijn."
    mainStatTitle="96%"
    mainStatSubTitle="van onze opdrachtgevers beoordeelt de samenwerking met Decernia als uitstekend"
    stats={[
      {
        stat: '99.8%',
        description: 'Projecten succesvol afgerond',
      },
      {
        stat: '100+',
        description: 'succesvolle implementaties',
      },
      {
        stat: '85%',
        description: 'jaarlijkse groei in opdrachtgevers',
      },
    ]}
  />
</MainLayout>
