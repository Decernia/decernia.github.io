---
import MainLayout from '@/layouts/MainLayout.astro';
import ProductDetail from '@components/sections/products/ProductDetail.astro';
import { getCollection } from 'astro:content';
import { SITE } from '@data/constants';

export async function getStaticPaths() {
  // Haal alleen de Nederlandse producten op (alles wat NIET in de en/ map staat)
  const productEntries = await getCollection(
    'products',
    ({ id }) => !id.startsWith('en/')
  );
  return productEntries.map(product => {
    // Aangezien ze in de root staan, is de id zelf gelijk aan de slug (geen 'en/' om te strippen)
    return {
      params: { id: product.id },
      props: { product },
    };
  });
}

const { product } = Astro.props;

const pageTitle: string = `${product.data.title} | ${SITE.title}`;
const metaDescription = product.data.description;
const ogTitle = `${product.data.title} | Decernia`;
const productSlug = product.id;
---

<MainLayout
  title={pageTitle}
  customDescription={metaDescription}
  customOgTitle={ogTitle}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    '@id': `${SITE.url}/products/${productSlug}`,
    name: product.data.title,
    description: product.data.description,
    brand: {
      '@type': 'Brand',
      name: 'Decernia',
    },
  }}
>
  <ProductDetail product={product} />
</MainLayout>
