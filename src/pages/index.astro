---
// Import the necessary components
import MainLayout from '@/layouts/MainLayout.astro';
import HeroSection from '@components/sections/landing/HeroSection.astro';
import HeroSectionAlt from '@components/sections/landing/HeroSectionAlt.astro';
import ClientsSection from '@components/sections/landing/ClientsSection.astro';
import FeaturesGeneral from '@components/sections/features/FeaturesGeneral.astro';
import FeaturesNavs from '@components/sections/features/FeaturesNavs.astro';
import TestimonialsSection from '@components/sections/testimonials/TestimonialsSection.astro';
import PricingSection from '@components/sections/pricing/PricingSection.astro';
import FAQ from '@components/sections/misc/FAQ.astro';
import AnnouncementBanner from '@components/ui/banners/AnnouncementBanner.astro';
import heroImage from '@images/hero-image.avif';
import faqs from '@data/faqs.json';
import features from '@data/features.json';
import pricing from '@data/pricing.json';
import featureImage from '@images/features-image.avif';
import construction from '@images/construction-image.avif';
import tools from '@images/automated-tools.avif';
import dashboard from '@images/dashboard-image.avif';
import { partnersData } from '@/data_files/constants';

const avatarSrcs: Array<string> = [
  'https://images.unsplash.com/photo-1568602471122-7832951cc4c5?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1531927557220-a9e23c1e4794?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1541101767792-f9b2b1c4f127?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&&auto=format&fit=facearea&facepad=3&w=300&h=300&q=80',
  'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?ixlib=rb-4.0.3&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=facearea&facepad=2&w=300&h=300&q=80',
];
---

<MainLayout>
  <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Ontdek ons Blog, maandelijks iets nieuws!"
    url="https://decernia.nl/blog/"
  />

  <HeroSection
    title=`Van Strategie naar Realisatie in <span
        class="text-decernia-amber dark:text-decernia-amber">ICT-Architectuur</span>`
    subTitle="Decernia biedt hoogwaardig advies en interim-management voor complexe IT-vraagstukken, van bedrijfsarchitectuur tot software-ontwerp."
    primaryBtn="Ontdek de mogelijkheden"
    primaryBtnURL="/products"
    secondaryBtn="Neem contact op"
    secondaryBtnURL="/contact"
    withReview={false}
    avatars={avatarSrcs}
    rating=`<span class="font-bold">4.8</span> / 5`
    starCount={4}
    reviews=`From Over <span class="font-bold">12.8k</span> Reviews`
    src={heroImage}
    alt="Whiteboard with notes, glasses and laptop. Photo by Compagnons"
  />

  <ClientsSection
    title="Vertrouwd door nationale organisaties"
    subTitle="Ervaar de betrouwbaarheid van ervaren architecten"
    partners={partnersData}
  />

  <FeaturesGeneral
    title="Inspringen op complexe marktbehoeften"
    subTitle="Organisaties in hooggereguleerde en data-intensieve domeinen staan voor de uitdaging om strategie, wetgeving en ICT-architectuur naadloos op elkaar aan te sluiten. Decernia biedt de strategische kaders, beproefde methodieken en domeinexpertise die nodig zijn om complexe veranderopgaven beheersbaar te maken en duurzame resultaten te borgen."
    src={featureImage}
    alt="ScrewFast products in floating boxes"
    features={features}
  />

  <FeaturesNavs
    title=`Architectuur <span class="text-decernia-amber dark:text-decernia-amber">op maat</span> voor uw digitale fundering.`
    tabs={[
      {
        heading: 'Geavanceerde Advies- en Inrichtingstools',
        content:
          "Decernia stemt haar methodieken en advies exact af op de inrichting van uw organisatie. Samen bouwen we aan een wendbaar en beheersbaar digitaal landschap.",
        svg: 'tools',
        src: tools,
        alt: 'Yellow and black heavy equipment on brown grass field',
        first: true,
      },
      {
        heading: 'Inzicht & Grip',
        content:
          "Beheers complexe architectuurvraagstukken met de intuïtieve sturingsinstrumenten van Decernia. Onze overzichtelijke visualisaties combineren gebruiksgemak met diepgaand inzicht, waardoor u direct grip krijgt op de voortgang, afhankelijkheden en risico's zodat u tot snelle en onderbouwde besluitvorming komt.",
        svg: 'dashboard',
        src: dashboard,
        alt: 'A screenshot or graphic representation of the intuitive dashboard',
        second: true,
      },
      {
        heading: 'Beproefde Functionaliteit & Kaders',
        content:
          "De robuuste architectuurkaders en functionaliteiten van Decernia zijn ontworpen om uw digitale transformatie te stroomlijnen. Wij reduceren de complexiteit in het landschap, verhogen de realisatiekracht van teams en borgen resultaten die voldoen aan de hoogste kwaliteits- en compliancestandaarden.",
        svg: 'house',
        src: construction,
        alt: 'Gray metal building frame near tower crane during daytime',
      },
    ]}
  />

  <TestimonialsSection
    title="Versnel uw veranderopgaven"
    subTitle="Decernia borgt een vliegende start van uw projecten met direct toepasbare architectuurkaders. Ervaar de wendbaarheid van gestroomlijnde besluitvorming."
    testimonials={[
      {
        content:
          'Decernia bracht direct rust en scherpte in onze transformatie. Hun doortastende advies en strakke kaders hebben onze besluitvorming aanzienlijk versneld. Zonder twijfel van doorslaggevende waarde voor onze complexe veranderopgaven!',
        author: 'Samantha Ruiz',
        role: 'CEO | ConstructIt Inc.',
        avatarSrc:
          'https://images.unsplash.com/photo-1593104547489-5cfb3839a3b5?q=80&w=1453&auto=format&fit=crop&ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D8&auto=format&fit=facearea&facepad=2&w=320&h=320&q=80',
      },
    ]}
    statistics={[
      {
        count: '100+',
        description:
          'strategische veranderopgaven en architectuurkaders succesvol begeleid',
      },
      {
        count: '35%',
        description:
          'kortere doorlooptijd van IT-transformaties door scherpe besluitvorming',
      },
      {
        count: '15%',
        description:
          'structurele reductie op beheerkosten en technologische schuld',
      },
      {
        count: '2x',
        description: 'snellere realisatie dankzij wendbare en robuuste architectuurkaders',
      },
    ]}
  />

  <PricingSection pricing={pricing} />

  <FAQ title="Veel </br>gestelde vragen" faqs={faqs} />

  <HeroSectionAlt
    title="Samen aan de Slag"
    subTitle="Doordachte architectuur ontmoet daadkrachtige uitvoering. Ontdek hoe het instrumentarium van Decernia uw veranderopgave versnelt."
    url="https://github.com/Decernia"
  />
</MainLayout>
