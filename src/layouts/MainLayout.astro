---
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '../components/sections/navbar&footer/FooterSection.astro';
import { SITE } from '@data/constants';
import '@styles/global.css';

const {
  title = SITE.titleDefault,
  meta,
  structuredData,
  lang = 'nl',
  customDescription = null,
  customOgTitle = null,
  hideFooter = false,
} = Astro.props;

interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
  hideFooter?: boolean;
}
---

<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
    />
    <title>{title}</title>
    <script is:inline>
      if (
        localStorage.getItem('hs_theme') === 'dark' ||
        (!('hs_theme' in localStorage) &&
          window.matchMedia('(prefers-color-scheme: dark)').matches)
      ) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
    <script>
      import '@scripts/lenisSmoothScroll.js';
      import '@scripts/demoForms.js';
    </script>
  </head>
  <body
    class="bg-decernia-navy text-decernia-muted selection:bg-decernia-amber flex min-h-screen flex-col antialiased selection:text-white"
  >
    <a
      href="#main-content"
      class="focus:bg-decernia-amber sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:px-4 focus:py-2 focus:text-white"
    >
      Skip to content
    </a>

    <Navbar />

    <main id="main-content" class="grow">
      <slot />
    </main>

    {!hideFooter && <FooterSection />}

    <script>
      import 'preline';
      const init = () =>
        (
          window as Window & { HSStaticMethods?: { autoInit?: () => void } }
        ).HSStaticMethods?.autoInit?.();
      if (document.readyState === 'loading')
        document.addEventListener('DOMContentLoaded', init);
      else init();
    </script>
    <style>
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
