---
import BrandLogo from '@components/BrandLogo.astro';
import type { Props } from '@astrojs/starlight/props';

const main = '/';
const locale = Astro.props.locale ? Astro.props.locale + '/' : '';
const docs = '/' + locale + 'welcome-to-docs/';
---

<span class="site-title mr-4 flex items-center gap-3">
  <a class="main-logo flex items-center" href={main} aria-label="Decernia Home">
    <div class="logo-wrapper">
      <BrandLogo />
    </div>
  </a>
  <a
    class="docs-badge flex items-center rounded bg-orange-500/10 px-2 py-0.5 text-xs font-bold tracking-wider text-orange-500 uppercase hover:bg-orange-500/20"
    href={docs}
    aria-label="Decernia Docs"
  >
    Docs
  </a>
</span>

<style>
  .site-title {
    display: flex;
    align-items: center;
  }

  /* Bepaal een expliciete breedte en hoogte voor de wrapper & SVG */
  .logo-wrapper {
    width: 140px;
    height: 35px;
    display: flex;
    align-items: center;
  }

  .logo-wrapper :global(svg) {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
    color: var(--sl-color-white, #ffffff) !important;
  }

  .site-title a {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-title a:focus-visible {
    outline: 0;
  }

  .site-title a:hover > :global(*) {
    transform: translateY(-0.1rem);
    transition: transform 250ms cubic-bezier(0.33, 1, 0.68, 1);
  }
</style>
