---
const { title, btnId, btnTitle, url } = Astro.props;

interface Props {
  title?: string;
  btnId: string;
  btnTitle: string;
  url: string;
}

const storageKey = `banner-dismissed:${btnId}`;
---

<astro-banner btnId={btnId} storageKey={storageKey} class="hidden">
  <div
    class="fixed start-1/2 bottom-0 z-50 mx-auto w-full -translate-x-1/2 transform p-6 sm:max-w-4xl"
    role="region"
    aria-label="Informational Banner"
  >
    <div
      class="rounded-xl border border-decernia-border bg-decernia-surface bg-[url('/banner-pattern.svg')] bg-cover bg-center bg-no-repeat p-4 text-center shadow-lg"
    >
      <div class="flex items-center justify-center">
        <div class="ml-auto flex items-center gap-x-2">
          {
            title && (
              <p class="me-2 inline-block font-medium text-decernia-muted">
                {title}
              </p>
            )
          }
          <a
            class="group inline-flex items-center gap-x-2 rounded-full border border-decernia-amber bg-decernia-amber/10 px-4 py-2 text-sm font-semibold text-decernia-amber transition duration-300 hover:bg-decernia-amber hover:text-white focus:outline-hidden"
            href={url}
            target="_blank"
          >
            {btnTitle}
            <svg
              class="size-4 shrink-0 transition duration-300 group-hover:translate-x-1"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg
            >
          </a>
        </div>
        <button
          type="button"
          class="ml-auto inline-flex items-center gap-x-2 rounded-full border border-transparent p-2 text-sm font-semibold text-decernia-muted transition duration-300 hover:bg-decernia-border hover:text-decernia-text focus:outline-hidden"
          id={btnId}
        >
          <span class="sr-only">Dismiss</span>
          <svg
            class="size-5 shrink-0"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
          >
        </button>
      </div>
    </div>
  </div>
</astro-banner>
<script>
  class AstroBanner extends HTMLElement {
    connectedCallback() {
      const btnId = this.getAttribute('btnId');
      const storageKey = this.getAttribute('storageKey');
      if (storageKey && localStorage.getItem(storageKey) === '1') {
        this.remove();
        return;
      }
      this.classList.remove('hidden');
      const button = btnId ? this.querySelector(`#${btnId}`) : null;
      if (button != null) {
        button.addEventListener('click', () => {
          if (storageKey) localStorage.setItem(storageKey, '1');
          this.remove();
        });
      }
    }
  }

  customElements.define('astro-banner', AstroBanner);
</script>