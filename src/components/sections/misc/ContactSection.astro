---
import AuthBtn from '@components/ui/buttons/AuthBtn.astro';
import ContactIconBlock from '@components/ui/blocks/ContactIconBlock.astro';
import TextInput from '@components/ui/forms/input/TextInput.astro';
import EmailContactInput from '@components/ui/forms/input/EmailContactInput.astro';
import PhoneInput from '@components/ui/forms/input/PhoneInput.astro';
import TextAreaInput from '@components/ui/forms/input/TextAreaInput.astro';
import Icon from '@components/ui/icons/Icon.astro';
import { getMarketingLocale } from '@utils/locale';

const locale = getMarketingLocale(Astro.url.pathname, Astro.currentLocale);

const copy =
  locale === 'en'
    ? {
        title: 'Contact us',
        subTitle:
          "Have questions or want to discuss a project? Reach out, and let's discuss your system and network architecture needs.",
        formTitle: 'Fill in the form below',
        formSubTitle: "We'll get back to you within 1-2 business days.",
        firstName: 'First Name',
        lastName: 'Last Name',
        subjectLabel: 'Subject / Advisory Package',
        subjectDefault: 'General Question / Other',
        subjectConsultation: 'No-obligation Consultation',
        subjectFundament: 'Architecture Foundation (€490 / mo)',
        subjectStrategie: 'Strategy & Governance (€890 / mo)',
        subjectCustom: 'Custom Solution or Complex Portfolio',
        details: 'Your message or question',
        send: 'Send Message',
        demoMessage:
          'Thanks! (Demo only — wire a form endpoint to receive real messages.)',
        knowledgeHeading: 'Knowledgebase',
        knowledgeContent:
          'Browse through our insights and publications on system architecture.',
        knowledgeLink: 'Visit articles & guides',
        faqHeading: 'FAQ',
        faqContent:
          'Explore our FAQ for quick, clear answers to common questions.',
        faqLink: 'Visit FAQ',
        officeHeading: 'Office & Location',
        officeContent: 'Decernia',
        addressContent: 'The Netherlands',
        emailHeading: 'Contact us by email',
        emailContent: 'Prefer direct email? Send us a message at',
        emailAddress: 'info@decernia.nl',
      }
    : {
        title: 'Neem contact op',
        subTitle:
          'Heeft u een advies- of interimvraagstuk, of wilt u sparren over uw stelsel- en netwerkinrichting? Laat een bericht achter en we nemen zo snel mogelijk contact met u op.',
        formTitle: 'Vul het formulier in',
        formSubTitle: 'We reageren binnen 1 tot 2 werkdagen.',
        firstName: 'Voornaam',
        lastName: 'Achternaam',
        subjectLabel: 'Onderwerp / Adviespakket',
        subjectDefault: 'Algemene vraag / Overig',
        subjectConsultation: 'Vrijblijvend gesprek',
        subjectFundament: 'Architectuur Fundament (€490 / mnd)',
        subjectStrategie: 'Strategie & Regie (€890 / mnd)',
        subjectCustom: 'Maatwerk of Complex Portfolio',
        details: 'Uw bericht of vraagstuk',
        send: 'Verstuur bericht',
        demoMessage:
          'Bedankt! (Demo — koppel een formulier-endpoint om berichten te ontvangen.)',
        knowledgeHeading: 'Kennisbank & Artikelen',
        knowledgeContent:
          'Bekijk onze inzichten en publicaties over stelselarchitectuur.',
        knowledgeLink: 'Lees artikelen',
        faqHeading: 'Veelgestelde vragen',
        faqContent:
          'Bekijk onze FAQ voor snelle en duidelijke antwoorden op veelgestelde vragen.',
        faqLink: 'Bekijk FAQ',
        officeHeading: 'Kantoor & Locatie',
        officeContent: 'Decernia',
        addressContent: 'Nederland',
        emailHeading: 'Direct contact via e-mail',
        emailContent: 'Stuur ons rechtstreeks een bericht via e-mail op',
        emailAddress: 'info@decernia.nl',
      };
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
  <div class="mx-auto max-w-2xl lg:max-w-5xl">
    <div class="text-center">
      <h1
        class="text-2xl font-bold tracking-tight text-balance text-neutral-800 md:text-4xl md:leading-tight dark:text-neutral-200"
      >
        {copy.title}
      </h1>
      <p class="mt-1 text-pretty text-neutral-600 dark:text-neutral-400">
        {copy.subTitle}
      </p>
    </div>

    <div class="mt-12 grid items-center gap-6 lg:grid-cols-2 lg:gap-16">
      <div class="flex flex-col rounded-xl p-4 sm:p-6 lg:p-8">
        <h2
          class="mb-8 text-xl font-bold text-neutral-700 dark:text-neutral-300"
        >
          {copy.formTitle}
        </h2>
        <form data-demo-form data-demo-message={copy.demoMessage}>
          <div class="grid gap-4">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <TextInput
                id="hs-firstname-contacts"
                label={copy.firstName}
                name="hs-firstname-contacts"
              />
              <TextInput
                id="hs-lastname-contacts"
                label={copy.lastName}
                name="hs-lastname-contacts"
              />
            </div>
            <EmailContactInput id="hs-email-contacts" />
            <PhoneInput id="hs-phone-number" />

            {/* Dropdown voor selectie van onderwerp/pakket */}
            <div>
              <label
                for="hs-select-subject"
                class="mb-2 block text-sm font-medium text-neutral-800 dark:text-neutral-200"
              >
                {copy.subjectLabel}
              </label>
              <select
                id="hs-select-subject"
                name="subject"
                class="block w-full rounded-lg border border-neutral-200 bg-neutral-50 px-4 py-3 text-sm text-neutral-700 focus:border-orange-500 focus:ring-1 focus:ring-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-neutral-300"
              >
                <option value="other">{copy.subjectDefault}</option>
                <option value="consultation">{copy.subjectConsultation}</option>
                <option value="foundation">{copy.subjectFundament}</option>
                <option value="strategy-governance"
                  >{copy.subjectStrategie}</option
                >
                <option value="custom">{copy.subjectCustom}</option>
              </select>
            </div>

            <TextAreaInput
              id="hs-about-contacts"
              label={copy.details}
              name="hs-about-contacts"
            />
          </div>

          <div class="mt-4 grid">
            <AuthBtn title={copy.send} />
          </div>

          <div class="mt-3 text-center">
            <p class="text-sm text-neutral-600 dark:text-neutral-400">
              {copy.formSubTitle}
            </p>
            <p
              class="mt-2 hidden text-sm text-orange-500 dark:text-orange-400"
              data-demo-status
              aria-live="polite"
            >
            </p>
          </div>
        </form>
      </div>

      <div class="divide-y divide-neutral-300 dark:divide-neutral-700">
        <ContactIconBlock
          heading={copy.knowledgeHeading}
          content={copy.knowledgeContent}
          isLinkVisible={true}
          linkTitle={copy.knowledgeLink}
          linkURL="#"
          isArrowVisible={true}
          ><Icon name="question" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.faqHeading}
          content={copy.faqContent}
          isLinkVisible={true}
          linkTitle={copy.faqLink}
          linkURL="#"
          isArrowVisible={true}
          ><Icon name="chatBubble" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.officeHeading}
          content={copy.officeContent}
          isAddressVisible={true}
          addressContent={copy.addressContent}
          ><Icon name="mapPin" />
        </ContactIconBlock>

        <ContactIconBlock
          heading={copy.emailHeading}
          content={copy.emailContent}
          isLinkVisible={true}
          linkTitle={copy.emailAddress}
          linkURL={`mailto:${copy.emailAddress}`}
          ><Icon name="envelopeOpen" />
        </ContactIconBlock>
      </div>
    </div>
  </div>
</section>

<!-- Client script dat de URL query direct uit de browser leest -->
<script is:inline>
  const updateDropdown = () => {
    // 1. Haal de parameter direct uit de browser URL
    const urlParams = new URLSearchParams(window.location.search);
    const rawSubject =
      urlParams.get('subject') || urlParams.get('onderwerp') || '';
    const subjectRaw = rawSubject.toLowerCase().trim();

    if (!subjectRaw) return;

    let targetValue = 'other';
    if (['foundation', 'fundament'].includes(subjectRaw)) {
      targetValue = 'foundation';
    } else if (
      ['strategy-governance', 'strategie-regie', 'strategie'].includes(
        subjectRaw
      )
    ) {
      targetValue = 'strategy-governance';
    } else if (
      ['custom', 'op-maat', 'op maat', 'tailored'].includes(subjectRaw)
    ) {
      targetValue = 'custom';
    } else if (['consultation', 'consultatie'].includes(subjectRaw)) {
      targetValue = 'consultation';
    }

    const selectEl = document.getElementById('hs-select-subject');
    if (!selectEl) return;

    // 2. Zet de native HTML select waarde
    selectEl.value = targetValue;

    // 3. Update Preline UI (indien actief)
    const applyPreline = () => {
      if (window.HSSelect) {
        const instance = window.HSSelect.getInstance(selectEl);
        if (instance) {
          instance.setValue(targetValue);
          return true;
        }
      }
      return false;
    };

    if (!applyPreline()) {
      let attempts = 0;
      const interval = setInterval(() => {
        attempts++;
        if (applyPreline() || attempts > 20) {
          clearInterval(interval);
        }
      }, 50);
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateDropdown);
  } else {
    updateDropdown();
  }
  document.addEventListener('astro:page-load', updateDropdown);
</script>
